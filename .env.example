# Copy to .env and adjust. .env is git-ignored.
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://eld:eld@localhost:5433/eld?sslmode=disable

# Separate database for integration tests (wiped by tests!).
TEST_DATABASE_URL=postgres://eld:eld@localhost:5433/eld_test?sslmode=disable

# Rate-limit counters shared by all API instances (docker-compose, host port
# 6380). Optional: empty = count in memory per instance, which is only
# correct when a single instance runs. Set it in production.
REDIS_URL=redis://localhost:6380/0

# Redis for integration tests (a separate database number).
TEST_REDIS_URL=redis://localhost:6380/1

# Email (password reset codes). Development: Mailpit from docker-compose,
# read the emails at http://localhost:8025 (no username/password).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@eld.local
SMTP_FROM_NAME=ELD
#
# Production with Gmail:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Google Account -> Security -> App passwords: create one (16 letters).
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#      SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<the app password>
#      SMTP_FROM=you@gmail.com   (must be the same Gmail address)
#      SMTP_FROM_NAME=ELD
# Gmail allows about 500 emails a day; use a transactional email service
# (SES, Postmark, SendGrid) when you outgrow that: only these values change.

# Billing (Stripe). Optional: leave STRIPE_SECRET_KEY empty and billing is
# off; everything else works. Use TEST keys (Stripe Dashboard, "Test mode"
# on → Developers → API keys); development refuses live keys.
#   STRIPE_SECRET_KEY:      sk_test_... server only, never in git or chat.
#   STRIPE_PUBLISHABLE_KEY: pk_test_... public, used by the browser (Stripe.js).
#   STRIPE_WEBHOOK_SECRET:  whsec_... printed by `stripe listen` (local) or
#                           shown on the webhook endpoint in the Dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# stripe-mock (docker compose) for the Stripe contract tests. Fake, offline.
STRIPE_MOCK_URL=http://localhost:12111

# HMAC key for signing access tokens (min 32 bytes). Generate your own:
#   openssl rand -base64 48
# The placeholder below is deliberately too short: the app refuses to start
# until you replace it, so a publicly known secret can never be used.
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Load balancers / reverse proxies whose X-Forwarded-For header is trusted,
# comma-separated IPs or CIDRs (e.g. 10.0.0.0/8). Empty = none (direct access).
# Behind a load balancer this MUST be set, or all clients share one IP and
# one rate limit.
TRUSTED_PROXIES=


# Stripe keys
STRIPE_SECRET_KEY=sk_test_...        # was SK_TEST (put the rolled key here)
STRIPE_PUBLISHABLE_KEY=pk_test_...   # was PK_TEST
STRIPE_WEBHOOK_SECRET=